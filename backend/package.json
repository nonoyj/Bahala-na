{
  "name": "bahala-na-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bahala Na? — Firebase backend: Shared Barangay, run contributions, echoes (per HANDOFF §C.1–C.4).",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start",
    "deploy": "npm run build && firebase deploy --only functions,firestore:rules,firestore:indexes",
    "seed": "npm run build && node lib/seed.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
