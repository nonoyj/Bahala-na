rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Shared Barangay: public read, NO client write (Admin SDK / Cloud Function only).
    match /barangay/state {
      allow read: if true;
      allow write: if false;
    }

    // Echoes: public read, NO client write.
    match /echoes/{echoId} {
      allow read: if true;
      allow write: if false;
    }

    // Runs: readable/writable only by the owning player (written by the Cloud Function).
    match /runs/{runId} {
      allow read: if isOwner(resource.data.playerId);
      allow create: if isOwner(request.resource.data.playerId)
        && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Player profiles: only the owner.
    match /players/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}
